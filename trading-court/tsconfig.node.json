{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "noImplicitAny": false,
    "noImplicitReturns": false
  },
  "include": [
    "src/server.ts",
    "src/config.ts",
    "src/http.ts",
    "src/types/**/*",
    "src/engines/**/*",
    "src/fetchers/**/*",
    "src/backtest/**/*",
    "src/calibration/**/*"
  ],
  "exclude": [
    "node_modules", "dist", "public",
    "src/index.tsx", "src/renderer.tsx"
  ]
}
